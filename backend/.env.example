# Copy to .env. NEVER commit .env. AWS credentials come from `aws configure`, not from here.

# --- Run fully offline (default): no AWS account needed ---
USE_MOCK_LLM=true
USE_LOCAL_STORE=true

# --- Real AWS mode: set both to false, then fill the rest ---
AWS_REGION=us-east-1
# Use a model that is ENABLED in your Bedrock console (Model access). Some accounts need an
# inference-profile id such as us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
DDB_TABLE=echomind-days
DDB_COMMITMENTS=echomind-commitments
DDB_REMINDERS=echomind-reminders
DDB_DIGESTS=echomind-digests
S3_BUCKET=
USE_BEE=false
ESCALATE_AFTER_MIN=60
